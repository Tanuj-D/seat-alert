# Copy to .env and fill in. Everything is optional for local development.

# DATABASE_URL=postgresql+psycopg://user:pass@localhost/seat_alert
BASE_URL=http://localhost:8000

# Leave SMTP_HOST empty to print emails to the console instead of sending them.
# Gmail example: create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=UNC Seat Alert <you@gmail.com>

# MAX_WATCHES_PER_USER=10
# VERIFY_EMAIL_COOLDOWN_SECONDS=300
# CREATE_WATCH_LIMIT_PER_MINUTE=10
# CHECK_INTERVAL_SECONDS=120
# CHECK_REQUEST_DELAY_SECONDS=1.0
